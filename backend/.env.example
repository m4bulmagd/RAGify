# Project
PROJECT_NAME="RAGify"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# Security
SECRET_KEY="changeme_production_key_here"
ACCESS_TOKEN_EXPIRE_MINUTES=11520 # 8 days
ALGORITHM="HS256"
SECURE_COOKIES=False # Set to True in production with HTTPS

# CORS
# BACKEND_CORS_ORIGINS=["http://localhost:3000", "https://localhost:3000"]

# Database
POSTGRES_SERVER="localhost"
POSTGRES_USER="ragify"
POSTGRES_PASSWORD="ragify_password"
POSTGRES_DB="ragify_db"
POSTGRES_PORT=5432
# DATABASE_URI=postgresql+asyncpg://ragify:ragify_password@localhost:5432/ragify_db

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
# REDIS_URL=redis://localhost:6379/0

# Qdrant
# QDRANT_HOST="localhost"
# QDRANT_PORT=6333
# QDRANT_API_KEY="" # Optional
# QDRANT_URL=http://localhost:6333

# External APIs
OPENAI_API_KEY="sk-..."
GOOGLE_API_KEY=""

# Phoenix Observability
PHOENIX_COLLECTOR_ENDPOINT="http://localhost:6006"

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=ragify-documents
S3_REGION=us-east-1

# File Upload
MAX_UPLOAD_SIZE=10485760 # 10MB
ALLOWED_UPLOAD_CONTENT_TYPES=["application/pdf", "text/plain", "text/markdown", "text/csv"]

